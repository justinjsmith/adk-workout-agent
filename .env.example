# Anthropic API key (for LLM calls via LiteLLM)
ANTHROPIC_API_KEY=

# Google Cloud project
GCP_PROJECT_ID=

# Firestore database (default is fine for dev)
FIRESTORE_DATABASE=(default)

# Coach email address (used to filter Gmail)
COACH_EMAIL=

# Your Gmail (for OAuth / app login)
USER_EMAIL=

# Storage backend: "local" (JSON files) or "firestore"
STORAGE_BACKEND=local

# Flask
FLASK_SECRET_KEY=change-me
FLASK_ENV=development
PORT=8080
